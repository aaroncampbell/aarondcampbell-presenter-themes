{
	"name": "aarondcampbell-presenter-themes",
	"version": "1.3.0",
	"private": true,
	"description": "Private Presenter themes and integrations for AaronDCampbell.com.",
	"license": "GPL-3.0-or-later",
	"engines": {
		"node": ">=24 <25",
		"npm": ">=11 <12"
	},
	"packageManager": "npm@11.12.1",
	"scripts": {
		"check": "npm run check:js && npm run test:js",
		"check:audit": "npm audit",
		"check:js": "node --check js/chartjs-plugin.js && node --check tools/package-plugin.mjs",
		"package": "node tools/package-plugin.mjs",
		"test": "npm run test:js",
		"test:js": "node --test tests/js/*.test.js"
	}
}
